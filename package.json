{
  "name": "ismail-platform",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --experimental-strip-types scripts/run-unit-tests.mjs",
    "verify": "npm run typecheck && npm run test:unit && next build",
    "qa:content": "node scripts/content-qa.mjs",
    "qa:secrets": "node scripts/check-secrets.mjs",
    "qa:theme": "node scripts/theme-qa.mjs",
    "qa:rls": "node scripts/audit-rls.mjs",
    "qa:citations": "node scripts/check-citations.mjs",
    "qa:matrix": "node scripts/content-matrix.mjs",
    "check:smoke": "node scripts/smoke-content.mjs",
    "check:fields": "node scripts/check-fields.mjs",
    "check:tax": "node scripts/tax-coverage.mjs",
    "check:links": "node scripts/crawl-links.mjs --max=2500"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@tailwindcss/typography": "^0.5.20",
    "bcryptjs": "^3.0.3",
    "next": "^15.5.27",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^6.32.1",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/web-push": "^3.6.4",
    "dotenv": "^18.0.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3"
  }
}
