{
  "name": "ismail-platform",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "npm run typecheck && npm run lint && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "test:unit": "node --experimental-strip-types scripts/run-unit-tests.mjs",
    "verify": "npm run test:unit && npm run build",
    "qa:content": "node scripts/content-qa.mjs",
    "qa:secrets": "node scripts/check-secrets.mjs",
    "qa:theme": "node scripts/theme-qa.mjs",
    "qa:i18n": "node scripts/qa-i18n.mjs",
    "qa:production": "node scripts/verify-production.mjs",
    "qa:rls": "node scripts/audit-rls.mjs",
    "qa:rls:strict": "node scripts/audit-rls.mjs --strict",
    "qa:citations": "node scripts/check-citations.mjs",
    "import:quran-refs": "node --experimental-strip-types scripts/import-quran-references.ts",
    "import:hadith-refs": "node --experimental-strip-types scripts/import-hadith-references.ts",
    "fix:citations": "node --experimental-strip-types scripts/apply-citation-fixes.ts",
    "qa:matrix": "node scripts/content-matrix.mjs",
    "og:generate": "node scripts/generate-og.mjs",
    "qa:review": "node scripts/check-review-coverage.mjs",
    "qa:review:strict": "node scripts/check-review-coverage.mjs --strict",
    "qa:migrations": "node scripts/check-migrations.mjs",
    "qa:all": "npm run typecheck && npm run test:unit && npm run qa:content && npm run qa:citations && npm run qa:theme && npm run qa:secrets && npm run qa:rls && npm run qa:migrations && npm run qa:control-surface",
    "audit:control-surface": "node scripts/control-surface-audit.mjs",
    "qa:control-surface": "node scripts/control-surface-audit.mjs --strict",
    "check:smoke": "node scripts/smoke-content.mjs",
    "check:fields": "node scripts/check-fields.mjs",
    "check:tax": "node scripts/tax-coverage.mjs",
    "check:links": "node scripts/crawl-links.mjs --max=2500"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@tailwindcss/typography": "^0.5.20",
    "bcryptjs": "^3.0.3",
    "next": "15.5.28",
    "nodemailer": "^10.1.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^6.32.1",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/web-push": "^3.6.4",
    "dotenv": "^18.0.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "postcss": "^8.5.31",
    "postcss-selector-parser": "^7.1.7"
  }
}
