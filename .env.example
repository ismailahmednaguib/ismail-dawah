# Public Supabase settings (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Supabase settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Session signing secrets (use long random values in production)
APP_SESSION_SECRET=replace-with-a-long-random-secret
USER_SESSION_SECRET=replace-with-a-different-long-random-secret
ADMIN_SESSION_SECRET=replace-with-another-long-random-secret
OWNER_EMAIL=ismailahmednaguib@gmail.com

# Canonical site URL
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional Google Play listing (dashboard setting "playStoreUrl" overrides this)
NEXT_PUBLIC_PLAY_STORE_URL=
CSRF_REQUIRE_ORIGIN=true
CSRF_ALLOWED_ORIGINS=

# Cloudflare Turnstile (اختياري). يجب ضبط المفتاحين معًا؛ إن غاب أحدهما يُتجاوز التحقق.
# أنشئ المفتاحين من: https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Uploads
UPLOAD_BUCKET=site
UPLOAD_AUTO_CREATE_BUCKET=false
UPLOAD_MAX_TOTAL_BYTES=52428800
UPLOAD_IMAGE_MAX_BYTES=5242880
UPLOAD_AUDIO_MAX_BYTES=52428800
UPLOAD_VIDEO_MAX_BYTES=104857600
UPLOAD_DOC_MAX_BYTES=26214400
UPLOAD_ALLOW_MISSING_ORIGIN=false

# النسخ الاحتياطي اليومي (حاوية خاصة). الأنسب إنشاؤها عبر migration.
BACKUP_BUCKET=backups
BACKUP_AUTO_CREATE_BUCKET=false

# Email delivery (verification, password reset, journey, contact)
# الخيار أ: Resend (يتطلب دومينًا موثّقًا في Resend)
RESEND_API_KEY=
EMAIL_FROM=
# الخيار ب: SMTP بلا دومين (مثل Gmail App Password)
# Gmail: SMTP_HOST=smtp.gmail.com · SMTP_PORT=465 · SMTP_SECURE=true
# SMTP_USER=you@gmail.com · SMTP_PASS=كلمة-مرور-التطبيق-16-حرفًا
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@example.com

# Scheduled jobs (email journey + daily backup) — required for /api/cron/*
CRON_SECRET=replace-with-a-long-random-cron-secret

# Optional constrained assistant (server-only; disabled from the dashboard by default)
AI_ASSISTANT_API_KEY=
AI_ASSISTANT_ENDPOINT=https://api.openai.com/v1/chat/completions
